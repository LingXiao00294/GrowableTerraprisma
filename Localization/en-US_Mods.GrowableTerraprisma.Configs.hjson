GrowableTerraprismaConfig: {
	DisplayName: Growable Terraprisma Config

	BaseDamage: {
		Label: Base Damage
		Tooltip: Starting weapon damage before growth damage
	}

	BossGrowthRate: {
		Label: Growth per Encounter
		Tooltip: Share of the current phase's remaining damage budget gained from each valid Boss encounter; later kills have diminishing returns
	}

	Phase1Cap: {
		Label: Phase 1 Budget
		Tooltip: Maximum growth damage from King Slime through the world evil Boss
	}

	Phase2Cap: {
		Label: Phase 2 Budget
		Tooltip: Maximum growth damage from Queen Bee through Wall of Flesh
	}

	Phase3Cap: {
		Label: Phase 3 Budget
		Tooltip: Maximum growth damage from early Hardmode through the mechanical Bosses
	}

	Phase4Cap: {
		Label: Phase 4 Budget
		Tooltip: Maximum growth damage from the Plantera tier
	}

	Phase5Cap: {
		Label: Phase 5 Budget
		Tooltip: Maximum growth damage from Golem through Moon Lord
	}

	Phase6Cap: {
		Label: Phase 6 Budget
		Tooltip: Maximum growth damage from the Profaned Guardians through Providence
	}

	Phase7Cap: {
		Label: Phase 7 Budget
		Tooltip: Maximum growth damage from the Sentinels through Old Duke
	}

	Phase8Cap: {
		Label: Phase 8 Budget
		Tooltip: Maximum growth damage from Devourer of Gods through Yharon
	}

	Phase9Cap: {
		Label: Phase 9 Budget
		Tooltip: Maximum growth damage from Exo Mechs, Supreme Calamitas, and Primordial Wyrm
	}

	UltraTerraprismaDamageMultiplier: {
		Label: Ultra Terraprisma Damage Multiplier
		Tooltip: Base damage multiplier for uprisma; its extra behaviors are balanced separately
	}

	Headers: {
		BaseStats: Base Stats
		GrowthCurve: Growth Curve
